{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "V-Notch Tauri",
  "version": "0.1.0",
  "identifier": "au.com.aukalen.vnotch-tauri",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:1430",
    "beforeDevCommand": "npm run dev:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "V-Notch",
        "width": 1500,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "zoomHotkeysEnabled": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
